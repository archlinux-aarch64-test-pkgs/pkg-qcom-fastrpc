post_install() {
  systemd-sysusers
  udevadm control --reload-rules
  udevadm trigger --subsystem-match=misc
  udevadm trigger --subsystem-match=dma_heap

  echo ""
  echo ">>> To use FastRPC devices as a regular user, add yourself to the 'fastrpc' group:"
  echo ">>>   sudo usermod -aG fastrpc \$USER"
  echo ">>> Then log out and log back in for the change to take effect."
  echo ""
}

post_upgrade() {
  post_install
}
